@dataclass(frozen=True)
class ErrorPattern:
    transaction: str
    method: str
    exception_type: str
    exception_value: str
    handled: bool
    frames: tuple[tuple[str, str, int, str], ...]
    tags: tuple[tuple[str, str], ...] = ()

    def event(self, timestamp: datetime, release: str) -> dict[str, Any]:
        return {
            "event_id": uuid4().hex,
            "platform": "python",
            "level": "error",
            "timestamp": timestamp.timestamp(),
            "environment": ENVIRONMENT,
            "release": release,
            "transaction": self.transaction,
            "server_name": f"checkout-api-{random.choice(('7d9f4-xk2p1', '7d9f4-m8qzn', '7d9f4-c41rt'))}",
            "tags": dict(self.tags),
            "user": {"id": str(random.randint(10_000, 99_999))},
            "request": {
                "url": f"https://shop.example.com{self.transaction}",
                "method": self.method,
            },
            "exception": {
                "values": [
                    {
                        "type": self.exception_type,
                        "value": self.exception_value,
                        "mechanism": {"type": "django", "handled": self.handled},
                        "stacktrace": {
                            "frames": [
                                {
                                    "filename": filename,
                                    "abs_path": f"/app/{filename}",
                                    "module": filename.removesuffix(".py").replace("/", "."),
                                    "function": function,
                                    "lineno": lineno,
                                    "context_line": context_line,
                                    "in_app": True,
                                }
                                for filename, function, lineno, context_line in self.frames
                            ]
                        },
                    }
                ]
            },
        }


@dataclass(frozen=True)
class Scenario:
    """Background errors for the whole history, plus errors a deploy introduces at the end."""

    project_name: str
    monitor_name: str
    threshold: int
    previous_release: str
    breaching_release: str
    background: tuple[tuple[ErrorPattern, int], ...]
    regression: ErrorPattern
    regression_counts: tuple[int, ...]
    history: timedelta = timedelta(hours=3)

    def events(self, now: datetime) -> Iterator[dict[str, Any]]:
        deploy = now - BUCKET * len(self.regression_counts)
        bucket_start = now - self.history
        while bucket_start < now:
            release = self.breaching_release if bucket_start >= deploy else self.previous_release
            patterns = list(self.background)
            if bucket_start >= deploy:
                index = round((bucket_start - deploy) / BUCKET)
                patterns.append((self.regression, self.regression_counts[index]))
            for pattern, count in patterns:
                for _ in range(count + random.randint(-1, 1)):
                    offset = timedelta(seconds=random.uniform(0, BUCKET.total_seconds()))
                    yield pattern.event(bucket_start + offset, release)
            bucket_start += BUCKET

    def monitor(self) -> dict[str, Any]:
        return {
            "name": self.monitor_name,
            "type": MetricIssue.slug,
            "dataSources": [
                {
                    "queryType": SnubaQuery.Type.ERROR.value,
                    "dataset": Dataset.Events.value,
                    "query": "",
                    "aggregate": "count()",
                    "timeWindow": int(BUCKET.total_seconds()),
                    "environment": ENVIRONMENT,
                    "eventTypes": [SnubaQueryEventType.EventType.ERROR.name.lower()],
                }
            ],
            "conditionGroup": {
                "logicType": "any",
                "conditions": [
                    {
                        "type": Condition.GREATER,
                        "comparison": self.threshold,
                        "conditionResult": DetectorPriorityLevel.HIGH,
                    },
                    {
                        "type": Condition.LESS_OR_EQUAL,
                        "comparison": self.threshold,
                        "conditionResult": DetectorPriorityLevel.OK,
                    },
                ],
            },
            "config": {"detectionType": AlertRuleDetectionType.STATIC.value},
        }


