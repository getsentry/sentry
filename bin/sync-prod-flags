#!/usr/bin/env python
"""Write prod Flagpole flags, as the sentry org sees them, to $SENTRY_CONF/prod-flags.json.

--values-out also writes the raw getsentry-features values.json, for getsentry to evaluate itself.
"""

import argparse
import json  # noqa: S003
import os
import subprocess
import sys
import tempfile
from pathlib import Path

import sentry_options
import yaml

NAMESPACE = "getsentry-features"
CONTEXT = {
    "organization_id": 1,
    "organization_slug": "sentry",
    "sentry_cell": "us",
    "sentry_region": "us",
    "subscription_plan-tier": "am3",
    "subscription_plan-family": ["enterprise", "business", "team"],
    "subscription_is-free": False,
    "subscription_on-non-enterprise-trial": False,
}

REMOTE = "https://github.com/getsentry/sentry-options-automator"
FLAGPOLE = "options/default/flagpole.yaml"
GIT_ENV = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}

parser = argparse.ArgumentParser()
parser.add_argument("--values-out", type=Path)
args = parser.parse_args()

conf = Path(os.environ.get("SENTRY_CONF", "~/.sentry")).expanduser()
# sentry's and getsentry's `devenv sync` both run this; the cache makes the second run cheap.
cache = conf / "flagpole-cache.json"
repo = Path(
    os.environ.get(
        "SENTRY_OPTIONS_AUTOMATOR_DIR",
        Path(__file__).resolve().parents[2] / "sentry-options-automator",
    )
)


def git(*cmd: str, cwd: Path | str | None = None) -> str:
    return subprocess.check_output(["git", *cmd], cwd=cwd, env=GIT_ENV, text=True, timeout=120)


def remote_main_sha() -> str | None:
    try:
        out = git("ls-remote", REMOTE, "refs/heads/main")
    except subprocess.SubprocessError:
        return None
    return out.split()[0] if out else None


def read_cache() -> tuple[str, str] | None:
    try:
        cached = json.loads(cache.read_text())
        return cached["sha"], cached["source"]
    except (OSError, ValueError, KeyError):
        return None


def fetch(sha: str) -> tuple[str, str]:
    if repo.is_dir():
        try:
            git("fetch", "--quiet", "origin", "main", cwd=repo)
            return sha, git("show", f"{sha}:{FLAGPOLE}", cwd=repo)
        except subprocess.SubprocessError:
            sys.stderr.write(f"couldn't read {sha[:12]} from {repo}, cloning from GitHub\n")
    with tempfile.TemporaryDirectory() as clone:
        git("clone", "--quiet", "--depth=1", "--filter=blob:none", "--no-checkout", REMOTE, clone)
        # main can move between ls-remote and clone; key the cache by what was read.
        return git("rev-parse", "HEAD", cwd=clone).strip(), git(
            "show", f"HEAD:{FLAGPOLE}", cwd=clone
        )


cached = read_cache()
sha = remote_main_sha()
if sha is not None:
    if cached is not None and cached[0] == sha:
        source = cached[1]
    else:
        sha, source = fetch(sha)
        conf.mkdir(parents=True, exist_ok=True)
        cache.write_text(json.dumps({"sha": sha, "source": source}))
elif repo.is_dir():
    sys.stderr.write(f"can't reach {REMOTE}; using {repo}'s origin/main, which may be stale\n")
    source = git("show", f"origin/main:{FLAGPOLE}", cwd=repo)
elif cached is not None:
    sys.stderr.write(f"can't reach {REMOTE}; using flagpole.yaml cached from {cached[0][:12]}\n")
    source = cached[1]
else:
    sys.exit(f"can't reach {REMOTE}, and there's no {repo} checkout or {cache} to fall back to")
options = yaml.safe_load(source)["options"]
values = json.dumps({"options": options}, default=str)

if args.values_out:
    args.values_out.parent.mkdir(parents=True, exist_ok=True)
    args.values_out.write_text(values)

with tempfile.TemporaryDirectory() as tmp:
    Path(tmp, "schemas").mkdir()
    Path(tmp, "values", NAMESPACE).mkdir(parents=True)
    Path(tmp, "values", NAMESPACE, "values.json").write_text(values)
    schema = {
        "version": "1.0",
        "type": "object",
        "patternProperties": {"^feature\\.": sentry_options.feature_property()},
    }
    os.environ["SENTRY_OPTIONS_DIR"] = tmp
    sentry_options.init(additional_schemas={NAMESPACE: json.dumps(schema)})
    checker = sentry_options.features(NAMESPACE)
    context = sentry_options.FeatureContext(CONTEXT, identity_fields=["organization_id"])
    flags = {
        name: bool(checker.try_has(name, context))
        for name in (key.removeprefix("feature.") for key in options)
    }

out = conf / "prod-flags.json"
out.write_text(json.dumps(flags, indent=2, sort_keys=True))
