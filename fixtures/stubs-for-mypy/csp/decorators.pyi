from collections.abc import Callable, Sequence
from typing import ParamSpec, TypeVar

_P = ParamSpec("_P")
_R = TypeVar("_R")

_Directive = str | Sequence[str]

def csp_exempt(f: Callable[_P, _R]) -> Callable[_P, _R]: ...
def csp_update(**kwargs: _Directive) -> Callable[[Callable[_P, _R]], Callable[_P, _R]]: ...
def csp_replace(**kwargs: _Directive) -> Callable[[Callable[_P, _R]], Callable[_P, _R]]: ...
def csp(**kwargs: _Directive) -> Callable[[Callable[_P, _R]], Callable[_P, _R]]: ...
