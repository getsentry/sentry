from typing import Any

from sentry_relay._lowlevel import lib as lib

class RustObject:
    def __init__(self) -> None: ...
    @classmethod
    def _from_objptr(cls, ptr: Any, shared: bool = False) -> Any: ...
    def _methodcall(self, func: Any, *args: Any) -> Any: ...
    def _get_objptr(self) -> Any: ...

def rustcall(func: Any, *args: Any) -> Any: ...
def decode_str(s: Any, free: bool = False) -> str: ...
def encode_str(s: str | bytes, mutable: bool = False) -> Any: ...
def make_buf(value: bytes) -> Any: ...
def decode_uuid(value: Any) -> Any: ...
