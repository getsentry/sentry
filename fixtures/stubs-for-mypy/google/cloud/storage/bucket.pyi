from collections.abc import Iterable
from typing import Any

from google.cloud.storage.blob import Blob
from google.cloud.storage.client import Client

class Bucket:
    name: str
    def __init__(self, client: Client, name: str | None = None, **kwargs: Any) -> None: ...
    def blob(self, blob_name: str, **kwargs: Any) -> Blob: ...
    def get_blob(self, blob_name: str, **kwargs: Any) -> Blob | None: ...
    def delete_blob(self, blob_name: str, **kwargs: Any) -> None: ...
    def list_blobs(
        self, prefix: str | None = None, delimiter: str | None = None, **kwargs: Any
    ) -> Iterable[Blob]: ...
