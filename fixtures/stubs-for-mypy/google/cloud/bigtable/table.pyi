from collections.abc import Iterable
from typing import Any

from .row import PartialRowData, Row
from .row_set import RowSet

class Table:
    def read_row(self, row_key: bytes | str, retry: Any = None) -> PartialRowData | None: ...
    def read_rows(
        self, row_set: RowSet | None = None, **kwargs: Any
    ) -> Iterable[PartialRowData]: ...
    def direct_row(self, row_key: bytes | str) -> Row: ...
    def mutate_rows(self, rows: Iterable[Row]) -> Iterable[Any]: ...
    def exists(self) -> bool: ...
    def create(self, column_families: dict[str, Any] | None = None) -> None: ...
    def delete(self) -> None: ...
