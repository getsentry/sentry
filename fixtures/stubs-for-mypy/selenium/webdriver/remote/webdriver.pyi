from collections.abc import Sequence
from typing import Any

from selenium.webdriver.remote.switch_to import SwitchTo
from selenium.webdriver.remote.webelement import WebElement

class WebDriver:
    current_url: str
    title: str
    current_window_handle: str
    window_handles: Sequence[str]
    switch_to: SwitchTo
    def get(self, url: str) -> None: ...
    def find_element(self, by: str = ..., value: str | None = ...) -> WebElement: ...
    def find_elements(self, by: str = ..., value: str | None = ...) -> list[WebElement]: ...
    def close(self) -> None: ...
    def quit(self) -> None: ...
    def refresh(self) -> None: ...
    def execute_script(self, script: str, *args: Any) -> Any: ...
    def execute_cdp_cmd(self, cmd: str, cmd_args: dict[str, Any]) -> dict[str, Any]: ...
    def get_window_size(self, window_handle: str = ...) -> dict[str, int]: ...
    def set_window_size(self, width: int, height: int, window_handle: str = ...) -> None: ...
    def get_log(self, log_type: str) -> list[dict[str, Any]]: ...
    def implicitly_wait(self, duration: float) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
