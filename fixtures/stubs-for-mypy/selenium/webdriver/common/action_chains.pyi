from typing import Any, Self

from selenium.webdriver.remote.webelement import WebElement

class ActionChains:
    def __init__(self, driver: Any, duration: int = 250, devices: Any = None) -> None: ...
    def move_to_element(self, to_element: WebElement) -> Self: ...
    def click(self, on_element: WebElement | None = None) -> Self: ...
    def send_keys(self, *keys_to_send: str) -> Self: ...
    def key_down(self, value: str, element: WebElement | None = None) -> Self: ...
    def key_up(self, value: str, element: WebElement | None = None) -> Self: ...
    def pause(self, seconds: float) -> Self: ...
    def perform(self) -> None: ...
    def reset_actions(self) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
