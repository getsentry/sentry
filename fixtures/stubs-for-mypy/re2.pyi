from collections.abc import Iterator

class error(Exception): ...

class Options:
    log_errors: bool

class _Match:
    def start(self, group: int | str = ...) -> int: ...
    def end(self, group: int | str = ...) -> int: ...

class _Regexp:
    def finditer(
        self, text: str, pos: int | None = ..., endpos: int | None = ...
    ) -> Iterator[_Match]: ...

def compile(pattern: str, options: Options | None = ...) -> _Regexp: ...
