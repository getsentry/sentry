class StatsClient:
    def __init__(
        self,
        host: str = "localhost",
        port: int = 8125,
        prefix: str | None = None,
        maxudpsize: int = 512,
        ipv6: bool = False,
    ) -> None: ...
    def incr(self, stat: str, count: float | int = 1, rate: float = 1) -> None: ...
    def timing(self, stat: str, delta: float, rate: float = 1) -> None: ...
    def gauge(self, stat: str, value: float, rate: float = 1) -> None: ...
    def set(self, stat: str, value: str | int | float, rate: float = 1) -> None: ...
