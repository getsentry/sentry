{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@sentry-internal/monorepo",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git://github.com/getsentry/sentry.git"
  },
  "type": "module",
  "scripts": {
    "postinstall": "rm -f node_modules/.bin/sentry",
    "typecheck": "tsc --build tsconfig.json static/app/serviceWorker/worker/tsconfig.json --builders 2",
    "type-coverage": "node scripts/type-coverage.ts -p tsconfig.json",
    "type-coverage-diff": "node scripts/type-coverage-diff.ts",
    "test": "node scripts/test.js --watch",
    "test-ci": "node scripts/testCi.js",
    "test-debug": "node --inspect-brk scripts/test.js --runInBand",
    "test-precommit": "node scripts/test.js --bail --findRelatedTests -u",
    "test-staged": "node scripts/test.js --findRelatedTests $(git diff --name-only --cached)",
    "lint": "pnpm run lint:deps && pnpm run lint:format && pnpm run lint:js && pnpm run lint:css",
    "lint:deps": "sherif --ignore-rule root-package-dependencies",
    "lint:js": "node scripts/custom-oxlint.ts",
    "lint:js:changed": "run-on-changed",
    "lint:css": "stylelint '**/*.[jt]sx'",
    "lint:format": "oxfmt --check",
    "fix": "pnpm run fix:format && pnpm run fix:oxlint",
    "fix:oxlint": "pnpm run lint:js --fix",
    "fix:format": "oxfmt",
    "dev": "pnpm install --frozen-lockfile && sentry devserver",
    "dev-ui": "SENTRY_UI_DEV_ONLY=1 SENTRY_UI_HOT_RELOAD=1 node scripts/dev-ui-server.ts",
    "dev-ui-production": "NODE_ENV=production SENTRY_UI_DEV_ONLY=1 SENTRY_WEBPACK_PROXY_PORT=7999 SENTRY_UI_HOT_RELOAD=1 rsbuild dev",
    "dev-ui-admin": "SENTRY_ADMIN_UI_DEV=1 pnpm run dev-ui",
    "dev-ui-storybook": "pnpm run dev-ui",
    "dev-acceptance": "NO_DEV_SERVER=1 NODE_ENV=development rsbuild build --watch",
    "build-deprecated-docs": "node api-docs/index.ts api-docs/openapi.json tests/apidocs/openapi-deprecated.json",
    "diff-docs": "node api-docs/openapi-diff.ts",
    "deref-api-docs": "node api-docs/index.ts tests/apidocs/openapi-spectacular.json tests/apidocs/openapi-derefed.json",
    "build-chartcuterie-config": "node config/build-chartcuterie.ts",
    "build-acceptance": "IS_ACCEPTANCE_TEST=1 NODE_ENV=production pnpm run build",
    "build-production": "NODE_ENV=production rsbuild build",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' rsbuild build",
    "build-js-loader": "node scripts/build-js-loader.ts",
    "build-js-po": "node build-utils/ts-extract-gettext.ts",
    "build-profile": "RSPACK_STATS=1 NODE_ENV=production node scripts/buildProfile.ts",
    "extract-form-fields": "node scripts/extractFormFields.ts",
    "gen:embed-widgets": "esbuild scripts/genEmbedWidgets.ts --bundle --platform=node --format=esm --outfile=.artifacts/genEmbedWidgets.mjs && node .artifacts/genEmbedWidgets.mjs",
    "gen:platform-info": "node scripts/genPlatformProductInfo.ts",
    "validate-api-examples": "pnpm --filter @sentry-internal/api-docs exec openapi-examples-validator ../tests/apidocs/openapi-derefed.json --no-additional-properties",
    "mkcert-localhost": "mkcert -key-file config/localhost-key.pem -cert-file config/localhost.pem localhost 127.0.0.1 dev.getsentry.net *.dev.getsentry.net && mkcert -install",
    "https-proxy": "caddy run --config - <<< '{\"apps\":{\"http\":{\"servers\":{\"srv0\":{\"listen\":[\":8003\"],\"routes\":[{\"handle\":[{\"handler\":\"reverse_proxy\",\"upstreams\":[{\"dial\":\"localhost:8000\"}]}]}],\"tls_connection_policies\":[{\"certificate_selection\":{\"any_tag\":[\"cert0\"]}}]}}},\"tls\":{\"certificates\":{\"load_files\":[{\"certificate\":\"./config/localhost.pem\",\"key\":\"./config/localhost-key.pem\",\"tags\":[\"cert0\"]}]}}}}'",
    "snapshots": "jest --config jest.config.snapshots.ts",
    "knip": "knip",
    "knip:prod": "pnpm run knip --production --exclude dependencies"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/css": "^11.13.5",
    "@emotion/is-prop-valid": "^1.4.0",
    "@emotion/react": "^11.14.0",
    "@jest/test-result": "30.5.1",
    "@mdx-js/loader": "3.1.1",
    "@popperjs/core": "^2.11.5",
    "@r4ai/remark-callout": "^0.6.2",
    "@rsbuild/core": "^2.2.12",
    "@rsbuild/plugin-basic-ssl": "^2.0.0",
    "@rsdoctor/rspack-plugin": "1.6.4",
    "@rspack/core": "2.2.8",
    "@rspack/plugin-react-refresh": "2.0.2",
    "@sentry-internal/global-search": "^1.0.0",
    "@sentry/conventions": "^0.26.0",
    "@sentry/core": "11.0.0",
    "@sentry/node": "11.0.0",
    "@sentry/react": "11.0.0",
    "@sentry/sqlish": "1.0.1",
    "@sentry/webpack-plugin": "5.4.1",
    "@stripe/react-stripe-js": "^3.9.2",
    "@stripe/stripe-js": "^5.10.0",
    "@swc/plugin-emotion": "19.0.0",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "5.101.4",
    "@types/gtag.js": "^0.0.12",
    "@types/history": "^3.2.5",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/trusted-types": "^2.0.7",
    "compression-webpack-plugin": "12.0.0",
    "core-js": "3.45.0",
    "css-loader": "7.1.4",
    "echarts-for-react": "3.0.6",
    "esbuild": "0.28.1",
    "framer-motion": "12.38.0",
    "gettext-parser": "9.1.1",
    "html-webpack-plugin": "5.6.3",
    "jest-fetch-mock": "4.2.0",
    "less": "4.9.1",
    "less-loader": "^13.0.0",
    "lodash": "^4.18.1",
    "mockdate": "3.0.5",
    "moment-timezone": "0.6.2",
    "nuqs": "2.10.2",
    "peggy": "5.0.6",
    "query-string": "7.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-popper": "^2.3.0",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "reflux": "0.4.1",
    "rehype-expressive-code": "^0.44.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "sentry": "workspace:@sentry-internal/app@*",
    "style-loader": "4.0.0",
    "swc-plugin-component-annotate": "1.18.0",
    "ts-checker-rspack-plugin": "1.6.2",
    "tslib": "^2.8.1",
    "yaml": "2.9.0",
    "zrender": "6.1.0"
  },
  "devDependencies": {
    "@boundaries/eslint-plugin": "7.2.0",
    "@e18e/eslint-plugin": "0.8.0",
    "@emotion/server": "^11.11.0",
    "@jest/environment": "30.5.1",
    "@jest/environment-jsdom-abstract": "30.5.1",
    "@jest/types": "30.5.1",
    "@mdx-js/mdx": "3.1.1",
    "@sentry/jest-environment": "8.1.0",
    "@swc-contrib/mut-cjs-exports": "19.0.0",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.7",
    "@types/gettext-parser": "8.0.0",
    "@types/node": "26.6.4",
    "eslint": "10.8.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-regexp": "3.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "74.0.0",
    "getsentry": "workspace:@sentry-internal/gs-app@*",
    "jest": "30.5.1",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-node": "30.5.1",
    "jest-fail-on-console": "3.3.4",
    "jest-resolve": "30.5.1",
    "jsdom": "30.1.1",
    "knip": "6.40.0",
    "odiff-bin": "4.3.8",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "oxlint-plugin-eslint": "1.85.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "^1.61.1",
    "postcss-styled-syntax": "0.7.0",
    "react-refresh": "0.19.0",
    "run-on-changed": "0.4.0",
    "sherif": "1.13.0",
    "sirv": "^3.0.2",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "^14.0.1",
    "terser": "5.51.2",
    "tinyglobby": "0.2.16",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "browserslist": {
    "production": [
      "last 10 Chrome versions",
      "last 10 Firefox versions",
      "last 4 Safari major versions",
      "last 3 iOS major versions",
      "Firefox ESR"
    ],
    "development": [
      "last 10 Chrome versions",
      "last 10 Firefox versions",
      "last 4 Safari major versions",
      "last 3 iOS major versions",
      "Firefox ESR"
    ],
    "test": [
      "current node"
    ]
  },
  "packageManager": "pnpm@12.10.1",
  "APIMethod": "stub",
  "proxyURL": "http://localhost:8000"
}
