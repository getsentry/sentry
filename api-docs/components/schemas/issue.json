{
  "Issue": {
    "type": "object",
    "required": [
      "lastSeen",
      "numComments",
      "userCount",
      "culprit",
      "title",
      "id",
      "assignedTo",
      "logger",
      "stats",
      "type",
      "annotations",
      "metadata",
      "status",
      "subscriptionDetails",
      "isPublic",
      "hasSeen",
      "shortId",
      "shareId",
      "firstSeen",
      "count",
      "permalink",
      "level",
      "isSubscribed",
      "isBookmarked",
      "project",
      "statusDetails"
    ],
    "properties": {
      "annotations": {
        "type": "array",
        "description": "Annotations on the issue, such as links to external issues.",
        "items": {
          "type": "string"
        }
      },
      "assignedTo": {
        "type": "object",
        "description": "The user or team the issue is assigned to. Null when the issue is unassigned.",
        "nullable": true,
        "required": ["type", "id", "name"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["user", "team"],
            "description": "Whether the assignee is a user or a team."
          },
          "id": {
            "type": "string",
            "description": "The ID of the user or team."
          },
          "name": {
            "type": "string",
            "description": "The display name of the user, or the slug of the team."
          },
          "email": {
            "type": "string",
            "description": "The email address of the user. Only set for users."
          }
        }
      },
      "count": {
        "type": "string",
        "description": "The total number of events in the issue."
      },
      "culprit": {
        "type": "string",
        "description": "The function or module where the issue occurs."
      },
      "firstSeen": {
        "type": "string",
        "description": "When the issue was first seen (ISO 8601)."
      },
      "hasSeen": {
        "type": "boolean",
        "description": "Whether the requesting user has seen the issue since it last occurred."
      },
      "id": {
        "type": "string",
        "description": "The ID of the issue."
      },
      "isBookmarked": {
        "type": "boolean",
        "description": "Whether the requesting user bookmarked the issue."
      },
      "isPublic": {
        "type": "boolean",
        "description": "Whether the issue is shared publicly."
      },
      "isSubscribed": {
        "type": "boolean",
        "description": "Whether the requesting user is subscribed to the issue."
      },
      "lastSeen": {
        "type": "string",
        "description": "When the issue was last seen (ISO 8601)."
      },
      "level": {
        "type": "string",
        "description": "The severity level of the issue, such as `error` or `warning`."
      },
      "logger": {
        "type": "string",
        "description": "The logger of the issue's events.",
        "nullable": true
      },
      "metadata": {
        "description": "Metadata of the issue. Its keys depend on the issue type.",
        "oneOf": [
          {
            "type": "object",
            "required": ["filename", "type", "value"],
            "properties": {
              "filename": {
                "type": "string",
                "description": "The file where the error was raised."
              },
              "type": {
                "type": "string",
                "description": "The type of the error."
              },
              "value": {
                "type": "string",
                "description": "The error message."
              }
            }
          },
          {
            "type": "object",
            "required": ["title"],
            "properties": {
              "title": {
                "type": "string",
                "description": "The title of the issue."
              }
            }
          }
        ]
      },
      "numComments": {
        "type": "integer",
        "description": "The number of comments on the issue."
      },
      "permalink": {
        "type": "string",
        "description": "The URL of the issue in Sentry."
      },
      "project": {
        "type": "object",
        "description": "The project the issue belongs to.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The ID of the project."
          },
          "name": {
            "type": "string",
            "description": "The name of the project."
          },
          "slug": {
            "type": "string",
            "description": "The slug of the project."
          }
        }
      },
      "shareId": {
        "type": "string",
        "description": "The ID used in the issue's public share URL. Null when the issue isn't shared.",
        "nullable": true
      },
      "shortId": {
        "type": "string",
        "description": "The short ID of the issue, such as `PROJECT-1A`."
      },
      "stats": {
        "type": "object",
        "description": "Event counts for the issue over time.",
        "properties": {
          "24h": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "description": "Hourly event counts for the last 24 hours, as [timestamp, count] pairs."
          }
        }
      },
      "status": {
        "type": "string",
        "description": "The status of the issue.",
        "enum": ["resolved", "unresolved", "ignored"]
      },
      "statusDetails": {
        "$ref": "#/IssueStatusDetails"
      },
      "subscriptionDetails": {
        "type": "object",
        "description": "Why the requesting user is subscribed to the issue. Null when there's no subscription.",
        "nullable": true,
        "properties": {
          "disabled": {
            "type": "boolean",
            "description": "Whether the requesting user turned off notifications for the issue."
          },
          "reason": {
            "type": "string",
            "description": "Why the requesting user is subscribed, such as `commented`, `assigned`, `bookmarked`, `changed_status`, `mentioned` or `unknown`."
          }
        }
      },
      "title": {
        "type": "string",
        "description": "The title of the issue."
      },
      "type": {
        "type": "string",
        "description": "The event type of the issue, such as `error` or `default`."
      },
      "userCount": {
        "type": "integer",
        "description": "The number of users affected by the issue."
      }
    }
  },
  "IssueDetailed": {
    "type": "object",
    "required": [
      "activity",
      "annotations",
      "assignedTo",
      "count",
      "culprit",
      "firstRelease",
      "firstSeen",
