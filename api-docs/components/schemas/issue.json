              }
            }
          },
          "ref": {
            "type": "string",
            "nullable": true
          },
          "shortVersion": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "string"
          }
        }
      },
      "firstSeen": {
        "type": "string"
      },
      "hasSeen": {
        "type": "boolean"
      },
      "id": {
        "type": "string"
      },
      "isBookmarked": {
        "type": "boolean"
      },
      "isPublic": {
