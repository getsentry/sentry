      },
      "title": {
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "userCount": {
        "type": "integer"
      }
    }
  },
  "IssueStatusDetails": {
    "type": "object",
    "description": "Details of the issue's status, such as when an ignore expires or which release resolves it. Empty when the status has no details.",
    "properties": {
      "ignoreCount": {
        "type": "integer",
        "nullable": true,
        "description": "Number of additional events after which the issue stops being ignored."
      },
      "ignoreUntil": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "When the issue stops being ignored."
      },
      "ignoreUserCount": {
        "type": "integer",
        "nullable": true,
        "description": "Number of additional affected users after which the issue stops being ignored."
      },
      "ignoreUserWindow": {
        "type": "integer",
        "nullable": true,
        "description": "Time window in minutes for ignoreUserCount."
      },
      "ignoreWindow": {
        "type": "integer",
        "nullable": true,
        "description": "Time window in minutes for ignoreCount."
      },
      "actor": {
        "type": "object",
        "nullable": true,
        "description": "User who ignored or resolved the issue.",
        "properties": {
          "id": { "type": "string", "description": "ID of the user." },
          "name": { "type": "string", "description": "Name of the user." },
          "username": { "type": "string", "description": "Username of the user." },
          "email": { "type": "string", "description": "Email address of the user." }
        }
      },
      "inNextRelease": {
        "type": "boolean",
        "description": "Whether the issue is resolved in the next release."
      },
      "inRelease": {
        "type": "string",
        "description": "Version of the release the issue is resolved in."
      },
      "inCommit": {
        "type": "string",
        "description": "Commit the issue is resolved in."
      },
      "pendingEvents": {
        "type": "integer",
        "description": "Number of events still waiting to be reprocessed."
      },
      "info": {
        "type": "object",
        "nullable": true,
        "description": "Reprocessing progress details.",
        "required": ["dateCreated", "syncCount", "totalEvents"],
        "properties": {
          "dateCreated": {
            "type": "string",
            "description": "When reprocessing started (ISO 8601)."
          },
          "syncCount": {
            "type": "integer",
            "description": "Number of events in the issue when reprocessing started."
          },
          "totalEvents": {
            "type": "integer",
            "description": "Number of events to reprocess, at most the requested maximum."
          }
        }
      }
    }
  }
}
