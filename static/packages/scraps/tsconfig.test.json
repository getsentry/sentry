{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": true,
    "declarationMap": true,
    "outDir": ".types",
    "tsBuildInfoFile": ".types/tsconfig.tsbuildinfo",
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "paths": {
      "@sentry/scraps/*": ["./src/*"],
      "scraps-test/*": ["./test/*"]
    }
  },
  "include": ["src", "test"],
  "exclude": [],
  "references": [
    {
      "path": "../icons"
    }
  ]
}
