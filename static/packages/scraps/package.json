{
  "name": "@sentry/scraps",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/getsentry/sentry.git",
    "directory": "static/packages/scraps"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js"
    },
    "./separator": {
      "types": "./dist/separator/index.d.ts",
      "import": "./dist/separator/index.js"
    },
    "./quote": {
      "types": "./dist/quote/index.d.ts",
      "import": "./dist/quote/index.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "verify": "node scripts/verify.mjs",
    "test": "sentry-test --config jest.config.mjs",
    "typecheck": "tsc --build tsconfig.test.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@emotion/styled": "^11.14.0",
    "@react-aria/utils": "3.34.1",
    "@types/react": "19.3.0"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "2.1.1",
    "@rslib/core": "1.0.3",
    "@sentry-internal/test-utils": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "expect-type": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
