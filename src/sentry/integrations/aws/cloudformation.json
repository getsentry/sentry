{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Read-only AWS telemetry access for Sentry Seer. Deploy once per AWS account.",
  "Parameters": {
    "SentryPrincipalArn": {
      "Type": "String",
      "Description": "Sentry's broker role ARN, provided during integration setup.",
      "AllowedPattern": "arn:aws:iam::[0-9]{12}:role/.+"
    },
    "ExternalId": {
      "Type": "String",
      "Description": "The external ID generated by Sentry for this installation.",
      "AllowedPattern": "[a-f0-9]{64}"
    }
  },
  "Resources": {
    "SentrySeerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "SentrySeerAccess",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"AWS": {"Ref": "SentryPrincipalArn"}},
              "Action": ["sts:AssumeRole", "sts:SetSourceIdentity"],
              "Condition": {"StringEquals": {"sts:ExternalId": {"Ref": "ExternalId"}}}
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SentrySeerTelemetry",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:DescribeAlarms",
                    "cloudwatch:DescribeAlarmHistory",
                    "cloudwatch:GetMetricData",
                    "cloudwatch:ListMetrics",
                    "logs:DescribeLogGroups",
                    "logs:DescribeQueryDefinitions",
                    "logs:StartQuery",
                    "logs:GetQueryResults",
                    "logs:StopQuery",
                    "logs:FilterLogEvents",
                    "logs:GetLogEvents",
                    "logs:ListLogAnomalyDetectors",
                    "logs:ListAnomalies",
                    "xray:Get*",
                    "xray:List*",
                    "xray:BatchGet*"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "signin:CreateOAuth2Token",
                  "Resource": "arn:aws:signin:*:*:service-principal/aws-mcp.amazonaws.com",
                  "Condition": {
                    "StringEquals": {"signin:OAuthGrantType": "client_credentials"}
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "Paste this role ARN into Sentry to finish setup.",
      "Value": {"Fn::GetAtt": ["SentrySeerRole", "Arn"]}
    }
  }
}
