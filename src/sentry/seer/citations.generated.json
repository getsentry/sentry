    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "issue"
        },
        "id": {
          "type": "string",
          "pattern": "^c_[0-9a-z]{4,32}$",
          "description": "Ledger id the agent cites, e.g. \"c_3fa1b2\". Stable for the same datum."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Short human label, e.g. \"POST /checkout span\" or \"cart.py:120-134\"."
        },
        "excerpt": {
          "description": "The exact text or value the claim relies on, copied from the tool output.",
          "type": "string",
          "maxLength": 1000
        },
        "observedAt": {
          "description": "When the cited datum happened, if it has a timestamp.",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "url": {
          "description": "Deep link built by Seer. The UI may build its own.",
          "type": "string",
          "format": "uri"
        },
        "locator": {
          "type": "object",
          "properties": {
            "groupId": {
              "type": "string",
              "pattern": "^\\d+$"
            },
            "shortId": {
              "type": "string",
              "minLength": 1
            },
            "stat": {
              "description": "A single issue-level statistic the claim relies on.",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "users",
                    "events",
                    "firstSeen",
                    "lastSeen"
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              },
              "required": [
                "name",
                "value"
              ]
            }
          },
          "required": [
            "groupId"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "locator"
