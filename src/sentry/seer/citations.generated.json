{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeerCitation",
  "version": 1,
  "kinds": [
    "issue",
    "event",
    "trace",
    "log",
    "replay",
    "profile",
    "query",
    "feedback",
    "code",
